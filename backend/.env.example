# ===== API 키 =====

# Google AI Studio 키 → 이야기 생성 LLM: Gemma, Gemini Flash / TTS 후보 1: Gemini TTS
GEMINI_API_KEY=

# OpenRouter 키 → 이야기 생성 LLM: Nemotron
OPENROUTER_API_KEY=


# Azure 음성 서비스(F0) 키·지역 → TTS 후보 2
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral

# 사전 실험에서 비교할 LLM 모델 ID는 eval/models.json 에 입력

# ===== 서비스 설정 (2차 API 서버부터 사용, 사전 실험 후 확정) =====

# 선택 횟수(2~5), 프롬프트 버전, 페이지 최대 글자 수
CHOICE_COUNT=4
PROMPT_VERSION=v2
MAX_PAGE_CHARS=150

# 기본 LLM (실험 1위 모델)
# 주소 - OpenRouter: https://openrouter.ai/api/v1
#       Gemini: https://generativelanguage.googleapis.com/v1beta/openai
PRIMARY_BASE_URL=
PRIMARY_API_KEY=
PRIMARY_MODEL=
PRIMARY_JSON_MODE=true

# 예비 LLM (기본 LLM 실패·한도 초과 시 사용)
SECONDARY_BASE_URL=
SECONDARY_API_KEY=
SECONDARY_MODEL=
SECONDARY_JSON_MODE=true
