# 실험 서버(lab)·평가 도구(eval)가 쓰는 API 키
# 이야기 생성 모델 목록과 각 모델이 쓸 키 이름은 eval/models.json 에 적는다.

# Google AI Studio → 이야기 생성(Gemma, Gemini Flash), TTS 후보 1(Gemini TTS)
GEMINI_API_KEY=

# OpenRouter → 이야기 생성(Nemotron 등)
OPENROUTER_API_KEY=

# Azure 음성 서비스(F0) → TTS 후보 2 (eval/tts_check 에서만 사용)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral

# Typecast → TTS 후보 3 (무료: 월 15,000자, 비상업·출처 표기 필수)
# https://studio.typecast.ai/developers/api
TYPECAST_API_KEY=

# ===== 서비스 API (app.main) =====
# GEMINI_API_KEY(기본 TTS)·TYPECAST_API_KEY(예비 TTS)는 위 값을 같이 쓴다.

# 기본 LLM. 주소 - OpenRouter: https://openrouter.ai/api/v1
#                  Gemini: https://generativelanguage.googleapis.com/v1beta/openai
PRIMARY_BASE_URL=
PRIMARY_API_KEY=
PRIMARY_MODEL=
PRIMARY_JSON_MODE=true
# 응답 대기 시간(초). 넘으면 바로 예비 모델로
PRIMARY_TIMEOUT=60

# 예비 LLM (기본 LLM 실패 시)
SECONDARY_BASE_URL=
SECONDARY_API_KEY=
SECONDARY_MODEL=
SECONDARY_JSON_MODE=true
SECONDARY_TIMEOUT=60

PROMPT_VERSION=v8

# 구간 서명 비밀값 (32자 이상, 비면 서버가 시작 안 함). 무작위 문자열로 채우고, 바꾸면 진행 중인 이야기는 이어지지 않는다
STORY_SECRET=

# 하루 한도 (한국 시간 기준, 서버 메모리에서 셈)
DAILY_STORIES_PER_USER=3
DAILY_STORIES_TOTAL=30

# 허용할 프론트 주소 (JSON 목록)
CORS_ORIGINS=["http://localhost:5173"]
