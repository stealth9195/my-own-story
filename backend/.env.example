# 실험 서버(lab)·평가 도구(eval)가 쓰는 API 키
# 이야기 생성 모델 목록과 각 모델이 쓸 키 이름은 eval/models.json 에 적는다.

# Google AI Studio → 이야기 생성(Gemma, Gemini Flash), TTS 후보 1(Gemini TTS)
GEMINI_API_KEY=

# OpenRouter → 이야기 생성(Nemotron 등)
OPENROUTER_API_KEY=

# Azure 음성 서비스(F0) → TTS 후보 2 (eval/tts_check 에서만 사용)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral

# Typecast → TTS 후보 3 (무료: 월 15,000자, 비상업·출처 표기 필수)
# https://studio.typecast.ai/developers/api
TYPECAST_API_KEY=
