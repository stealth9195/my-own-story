CHOICE_COUNT=4
PROMPT_VERSION=v1
MAX_PAGE_CHARS=250

# 기본 모델. OpenRouter: https://openrouter.ai/api/v1
# Gemini(OpenAI 호환): https://generativelanguage.googleapis.com/v1beta/openai
PRIMARY_BASE_URL=https://openrouter.ai/api/v1
PRIMARY_API_KEY=
PRIMARY_MODEL=
PRIMARY_JSON_MODE=true

# 예비 모델
SECONDARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SECONDARY_API_KEY=
SECONDARY_MODEL=
SECONDARY_JSON_MODE=true

# TTS 비교 (eval/tts_check.py)
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral

# 평가 도구 (eval/models.json, judges.json의 api_key_env)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
