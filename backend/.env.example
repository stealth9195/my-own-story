# 실험 서버(lab)·평가 도구(eval)가 쓰는 API 키
# 이야기 생성 모델 목록과 각 모델이 쓸 키 이름은 eval/models.json 에 적는다.

# Google AI Studio → 이야기 생성(Gemma, Gemini Flash), TTS 후보 1(Gemini TTS)
GEMINI_API_KEY=

# OpenRouter → 이야기 생성(Nemotron 등)
OPENROUTER_API_KEY=

# Azure 음성 서비스(F0) → TTS 후보 2 (eval/tts_check 에서만 사용)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral

# Typecast → TTS 후보 3 (무료: 월 15,000자, 비상업·출처 표기 필수)
# https://studio.typecast.ai/developers/api
TYPECAST_API_KEY=

# ===== 서비스 API (app.main) =====
# 모든 LLM·TTS 가 Google 모델이라 키는 위 GEMINI_API_KEY 하나만 넣으면 된다.
# (예비 TTS 는 TYPECAST_API_KEY)
# 주소는 코드 기본값(Gemini OpenAI 호환 주소)을 쓰므로 적지 않는다. 빈 값으로 적으면 기본값을 덮어쓰니 주의.

# 기본 LLM
PRIMARY_MODEL=gemini-3.5-flash-lite
# 응답 대기 시간(초). 넘으면 바로 예비 모델로
PRIMARY_TIMEOUT=60

# 예비 LLM (기본 LLM 실패 시)
SECONDARY_MODEL=gemini-3.1-flash-lite
SECONDARY_TIMEOUT=60

# 대비 LLM: 기본과 동시에 출발, 기본·예비가 모두 실패하면 먼저 통과한 글을 씀
# JSON 목록은 작은따옴표로 감싼다 (uv --env-file 이 큰따옴표를 지움)
BACKUP_MODELS='["gemma-4-26b-a4b-it","gemma-4-31b-it"]'
BACKUP_TIMEOUT=60

PROMPT_VERSION=v8

# 구간 서명 비밀값 (32자 이상, 비면 서버가 시작 안 함). 바꾸면 진행 중인 이야기는 이어지지 않는다
# 만들기: uv run python -c "import secrets;print(secrets.token_hex(32))"
STORY_SECRET=

# 하루 한도 (한국 시간 기준, 서버 메모리에서 셈)
DAILY_STORIES_PER_USER=3
DAILY_STORIES_TOTAL=30

# 허용할 프론트 주소 (JSON 목록)
CORS_ORIGINS='["http://localhost:5173"]'
